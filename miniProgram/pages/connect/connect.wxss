page {
  height: 100%;
  background: #f5f7fb;
}

.page-shell {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  overflow: hidden;
}

.hero-card {
  position: relative;
  flex: none;
  margin: 24rpx 24rpx 0;
  padding: 28rpx 30rpx 34rpx;
  overflow: hidden;
  border-radius: 38rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1967f2 0%, #3d7cff 55%, #6e91ff 100%);
  box-shadow: 0 24rpx 60rpx rgba(31, 101, 235, 0.25);
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.11);
}

.hero-orb-one {
  width: 300rpx;
  height: 300rpx;
  right: -110rpx;
  top: -150rpx;
}

.hero-orb-two {
  width: 210rpx;
  height: 210rpx;
  left: 250rpx;
  bottom: -150rpx;
}

.brand-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
}

.brand-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
}

.brand-logo {
  width: 52rpx;
  height: 52rpx;
}

.brand-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 16rpx;
}

.brand-name {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.brand-en {
  margin-top: 1rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 17rpx;
  letter-spacing: 1.5rpx;
}

.scan-chip {
  display: flex;
  align-items: center;
  height: 52rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 26rpx;
  color: rgba(255, 255, 255, 0.82);
  background: rgba(13, 60, 159, 0.2);
  font-size: 21rpx;
}

.scan-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #cbd7f6;
}

.scan-chip-active .scan-dot {
  background: #66f0b3;
  box-shadow: 0 0 0 8rpx rgba(102, 240, 179, 0.13);
  animation: scanPulse 1.4s ease-in-out infinite;
}

.hero-content {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  min-height: 230rpx;
  margin-top: 28rpx;
}

.hero-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding-right: 20rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 750;
  line-height: 1.25;
  letter-spacing: 1rpx;
}

.hero-desc {
  max-width: 420rpx;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  line-height: 1.7;
}

.radar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 190rpx;
  height: 190rpx;
  flex: none;
}

.radar-ring {
  position: absolute;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
}

.radar-ring-one {
  width: 132rpx;
  height: 132rpx;
}

.radar-ring-two {
  width: 184rpx;
  height: 184rpx;
}

.radar-active .radar-ring-one {
  animation: radarWave 2.1s ease-out infinite;
}

.radar-active .radar-ring-two {
  animation: radarWave 2.1s 0.8s ease-out infinite;
}

.device-visual {
  position: relative;
  z-index: 2;
  width: 82rpx;
  height: 104rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 25rpx;
  background: rgba(11, 48, 128, 0.33);
  box-shadow: 0 14rpx 26rpx rgba(12, 48, 130, 0.26);
}

.device-screen {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 13rpx;
  height: 58rpx;
  border-radius: 15rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.95), rgba(205, 230, 255, 0.75));
}

.device-button {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 10rpx;
  height: 10rpx;
  margin-left: -5rpx;
  border-radius: 50%;
  background: #ffffff;
}

.device-panel {
  display: flex;
  flex: 1;
  min-height: 0;
  flex-direction: column;
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 20rpx;
}

.section-copy {
  display: flex;
  flex-direction: column;
}

.section-title-row {
  display: flex;
  align-items: center;
}

.section-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 700;
}

.device-count {
  min-width: 42rpx;
  height: 38rpx;
  margin-left: 12rpx;
  padding: 0 11rpx;
  border-radius: 19rpx;
  color: #2f6df6;
  background: #e9f0ff;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-align: center;
}

.section-subtitle {
  margin-top: 7rpx;
  color: #8a94a8;
  font-size: 23rpx;
}

.refresh-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 66rpx;
  padding: 0 22rpx;
  border-radius: 33rpx;
  color: #2f6df6;
  background: #eaf1ff;
  font-size: 24rpx;
  font-weight: 600;
}

.refresh-button-pressed {
  opacity: 0.72;
  transform: scale(0.98);
}

.refresh-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
  line-height: 1;
}

.refresh-icon-active {
  animation: rotate 1.2s linear infinite;
}

.device-scroll {
  flex: 1;
  min-height: 0;
}

.device-card {
  display: flex;
  align-items: center;
  min-height: 180rpx;
  margin-bottom: 18rpx;
  padding: 24rpx 22rpx;
  border: 2rpx solid #eef1f6;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(31, 45, 77, 0.05);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.device-card-connected {
  border-color: #cfe0ff;
  background: linear-gradient(135deg, #ffffff, #f6f9ff);
}

.device-card-pressed {
  opacity: 0.85;
  transform: scale(0.985);
}

.device-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  flex: none;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #eaf2ff, #dbe9ff);
}

.mini-device {
  position: relative;
  width: 52rpx;
  height: 68rpx;
  border: 4rpx solid #3476f4;
  border-radius: 16rpx;
  background: #ffffff;
}

.mini-screen {
  position: absolute;
  left: 7rpx;
  right: 7rpx;
  top: 7rpx;
  height: 37rpx;
  border-radius: 9rpx;
  background: linear-gradient(145deg, #5d9cff, #b6d5ff);
}

.mini-button {
  position: absolute;
  left: 50%;
  bottom: 5rpx;
  width: 7rpx;
  height: 7rpx;
  margin-left: -3.5rpx;
  border-radius: 50%;
  background: #3476f4;
}

.online-dot {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 25rpx;
  height: 25rpx;
  border: 5rpx solid #ffffff;
  border-radius: 50%;
  background: #32c787;
}

.device-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  margin-left: 22rpx;
}

.device-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.device-name {
  max-width: 250rpx;
  overflow: hidden;
  color: #172033;
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.connected-label {
  margin-left: 10rpx;
  padding: 5rpx 10rpx;
  border-radius: 10rpx;
  color: #168c5d;
  background: #e4f8ef;
  font-size: 19rpx;
  font-weight: 600;
}

.device-id {
  max-width: 340rpx;
  margin-top: 9rpx;
  overflow: hidden;
  color: #7d879c;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.signal-row {
  display: flex;
  align-items: center;
  margin-top: 13rpx;
}

.signal-bars {
  display: flex;
  align-items: flex-end;
  width: 40rpx;
  height: 26rpx;
}

.signal-bar {
  width: 5rpx;
  margin-right: 3rpx;
  border-radius: 3rpx 3rpx 0 0;
  background: #d3d8e3;
}

.signal-bar:nth-child(1) { height: 8rpx; }
.signal-bar:nth-child(2) { height: 13rpx; }
.signal-bar:nth-child(3) { height: 19rpx; }
.signal-bar:nth-child(4) { height: 25rpx; }

.strong .signal-bar:nth-child(-n + 4) { background: #2fc888; }
.medium .signal-bar:nth-child(-n + 3) { background: #7fba3b; }
.weak .signal-bar:nth-child(-n + 2) { background: #e1a838; }
.very-weak .signal-bar:nth-child(1) { background: #ed6870; }

.signal-copy {
  margin-left: 5rpx;
  color: #9aa3b4;
  font-size: 20rpx;
}

.device-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  height: 58rpx;
  margin-left: 12rpx;
  padding: 0 16rpx;
  border-radius: 29rpx;
  color: #2f6df6;
  background: #edf3ff;
  font-size: 22rpx;
  font-weight: 650;
}

.device-action-loading {
  color: #6f7d96;
  background: #f1f3f7;
}

.action-arrow {
  width: 10rpx;
  height: 10rpx;
  margin-left: 8rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.action-spinner {
  width: 20rpx;
  height: 20rpx;
  margin-left: 9rpx;
  border: 3rpx solid #c7cedb;
  border-top-color: #61718d;
  border-radius: 50%;
  animation: rotate 0.9s linear infinite;
}

.empty-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 90rpx 50rpx 60rpx;
  text-align: center;
}

.empty-radar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 190rpx;
  height: 190rpx;
}

.empty-ring {
  position: absolute;
  border: 2rpx solid #cddcff;
  border-radius: 50%;
}

.empty-ring-one { width: 110rpx; height: 110rpx; }
.empty-ring-two { width: 174rpx; height: 174rpx; }

.empty-radar-active .empty-ring-one {
  animation: emptyWave 2s ease-out infinite;
}

.empty-radar-active .empty-ring-two {
  animation: emptyWave 2s 0.8s ease-out infinite;
}

.empty-core {
  width: 54rpx;
  height: 70rpx;
  border: 5rpx solid #4e82ed;
  border-radius: 18rpx;
  background: #e8f0ff;
}

.empty-title {
  margin-top: 22rpx;
  color: #27324a;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-desc {
  max-width: 520rpx;
  margin-top: 14rpx;
  color: #8b95a8;
  font-size: 23rpx;
  line-height: 1.7;
}

.empty-button {
  height: 72rpx;
  margin-top: 28rpx;
  padding: 0 30rpx;
  border-radius: 36rpx;
  color: #ffffff;
  background: #3476f4;
  font-size: 25rpx;
  line-height: 72rpx;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes scanPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.55; transform: scale(0.75); }
}

@keyframes radarWave {
  0% { opacity: 0.65; transform: scale(0.55); }
  100% { opacity: 0; transform: scale(1.2); }
}

@keyframes emptyWave {
  0% { opacity: 0.8; transform: scale(0.55); }
  100% { opacity: 0; transform: scale(1.15); }
}
