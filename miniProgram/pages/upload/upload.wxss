page {
  background: #f5f7fb;
}

.page-shell {
  min-height: 100vh;
  padding: 24rpx;
}

.device-banner {
  position: relative;
  overflow: hidden;
  padding: 28rpx 30rpx 30rpx;
  border-radius: 38rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #172a5f 0%, #214b9b 56%, #3478e5 100%);
  box-shadow: 0 20rpx 52rpx rgba(23, 58, 128, 0.22);
}

.device-banner-orb {
  position: absolute;
  right: -90rpx;
  top: -120rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.09);
}

.device-status-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.online-chip {
  display: flex;
  align-items: center;
  height: 50rpx;
  padding: 0 17rpx;
  border-radius: 25rpx;
  color: #c8ffea;
  background: rgba(25, 208, 139, 0.15);
  font-size: 21rpx;
}

.online-point {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #51e4a8;
  box-shadow: 0 0 0 8rpx rgba(81, 228, 168, 0.12);
}

.banner-device-icon {
  position: relative;
  width: 58rpx;
  height: 74rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.1);
}

.banner-screen {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 8rpx;
  height: 41rpx;
  border-radius: 9rpx;
  background: linear-gradient(145deg, #c7e6ff, #ffffff);
}

.banner-button {
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 7rpx;
  height: 7rpx;
  margin-left: -3.5rpx;
  border-radius: 50%;
  background: #ffffff;
}

.banner-title {
  position: relative;
  z-index: 2;
  display: block;
  margin-top: 18rpx;
  font-size: 43rpx;
  font-weight: 750;
  line-height: 1.3;
}

.banner-desc {
  position: relative;
  z-index: 2;
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 23rpx;
}

.device-id-box {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 18rpx;
  background: rgba(5, 23, 62, 0.22);
}

.device-id-label {
  flex: none;
  color: rgba(255, 255, 255, 0.58);
  font-size: 21rpx;
}

.device-id-value {
  flex: 1;
  margin-left: 18rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.94);
  font-family: Menlo, Monaco, monospace;
  font-size: 22rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content-section,
.history-section {
  margin-top: 34rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 4rpx 20rpx;
}

.section-copy {
  display: flex;
  flex-direction: column;
}

.section-title {
  color: #182137;
  font-size: 32rpx;
  font-weight: 720;
}

.section-desc {
  margin-top: 7rpx;
  color: #9099aa;
  font-size: 22rpx;
}

.step-label {
  color: #b2b9c6;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.type-grid {
  display: flex;
  flex-direction: column;
}

.type-card {
  position: relative;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.84);
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 35rpx rgba(36, 49, 79, 0.08);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.type-card-pressed {
  opacity: 0.88;
  transform: scale(0.985);
}

.type-card-wide {
  height: 220rpx;
}

.type-row {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
}

.type-card-half {
  width: calc(50% - 9rpx);
  height: 260rpx;
}

.type-background,
.type-overlay {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.type-background {
  opacity: 0.8;
}

.type-overlay {
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.82) 58%, rgba(255, 255, 255, 0.08) 100%);
}

.type-overlay-light {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.94));
}

.type-card-content {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  height: 100%;
  padding: 28rpx;
}

.type-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.type-icon-image {
  width: 82rpx;
  height: 82rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #417cf3, #6aa8ff);
  box-shadow: 0 10rpx 22rpx rgba(55, 116, 242, 0.24);
}

.type-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 22rpx;
}

.type-title {
  color: #192238;
  font-size: 29rpx;
  font-weight: 720;
}

.type-desc {
  margin-top: 9rpx;
  color: #7f899b;
  font-size: 21rpx;
  line-height: 1.45;
}

.type-arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.type-card-content > .type-arrow {
  margin-right: 8rpx;
  color: #4c72bd;
}

.type-card-column {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  height: 100%;
  flex-direction: column;
  padding: 24rpx;
}

.type-icon-gif,
.type-icon-video {
  width: 66rpx;
  height: 54rpx;
  margin-bottom: auto;
  border-radius: 17rpx;
}

.type-icon-gif {
  background: linear-gradient(145deg, #8e67e9, #ba8df5);
}

.type-icon-video {
  background: linear-gradient(145deg, #ef8b47, #f6bd66);
  font-size: 22rpx;
}

.round-arrow {
  position: absolute;
  right: 22rpx;
  bottom: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: #34415d;
  background: rgba(255, 255, 255, 0.82);
}

.history-title-row {
  display: flex;
  align-items: center;
}

.history-count {
  min-width: 38rpx;
  height: 34rpx;
  margin-left: 10rpx;
  padding: 0 10rpx;
  border-radius: 17rpx;
  color: #3b72dd;
  background: #e8f0ff;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.history-scroll {
  width: calc(100vw - 48rpx);
  margin-left: 0;
  white-space: nowrap;
}

.history-row {
  display: inline-flex;
  padding: 2rpx 0 14rpx;
}

.history-card {
  display: inline-flex;
  width: 220rpx;
  margin-right: 16rpx;
  overflow: hidden;
  flex-direction: column;
  border: 2rpx solid #eef1f6;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 9rpx 26rpx rgba(34, 48, 79, 0.055);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.history-card-pressed {
  opacity: 0.86;
  transform: scale(0.98);
}

.history-preview {
  position: relative;
  width: 100%;
  height: 190rpx;
  overflow: hidden;
  background: #edf1f7;
}

.history-media {
  width: 100%;
  height: 100%;
}

.history-type {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 18rpx;
  color: #ffffff;
  background: rgba(19, 30, 52, 0.66);
  font-size: 18rpx;
  font-weight: 650;
  line-height: 36rpx;
}

.video-play {
  position: absolute;
  left: 50%;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin: -26rpx 0 0 -26rpx;
  padding-left: 4rpx;
  border-radius: 50%;
  color: #ffffff;
  background: rgba(18, 29, 49, 0.62);
  font-size: 22rpx;
}

.history-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 68rpx;
  padding: 0 16rpx;
}

.history-name {
  color: #313b51;
  font-size: 22rpx;
  font-weight: 600;
}

.history-more {
  color: #a3abba;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.history-tail-space {
  width: 10rpx;
  flex: none;
}


.history-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 122rpx;
  border: 2rpx dashed #dfe4ec;
  border-radius: 26rpx;
  color: #8d97aa;
  background: rgba(255, 255, 255, 0.64);
  font-size: 22rpx;
}

.history-loading-spinner {
  width: 26rpx;
  height: 26rpx;
  margin-right: 13rpx;
  border: 4rpx solid #d3d9e4;
  border-top-color: #4c7fe6;
  border-radius: 50%;
  animation: historyRotate 0.9s linear infinite;
}

.history-empty {
  display: flex;
  align-items: center;
  padding: 26rpx;
  border: 2rpx dashed #dfe4ec;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.64);
}

.history-empty-icon {
  position: relative;
  width: 82rpx;
  height: 72rpx;
  flex: none;
  border: 4rpx solid #b9c3d4;
  border-radius: 18rpx;
}

.empty-picture-line {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: 13rpx;
  height: 20rpx;
  border-top: 4rpx solid #b9c3d4;
  transform: skewY(-22deg);
}

.empty-picture-dot {
  position: absolute;
  right: 14rpx;
  top: 13rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #b9c3d4;
}

.history-empty-copy {
  display: flex;
  flex-direction: column;
  margin-left: 22rpx;
}

.history-empty-title {
  color: #495369;
  font-size: 25rpx;
  font-weight: 650;
}

.history-empty-desc {
  margin-top: 7rpx;
  color: #929bac;
  font-size: 21rpx;
}

.sheet-layer {
  position: fixed;
  z-index: 1000;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
}

.sheet-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(12, 20, 37, 0.5);
  animation: maskIn 0.2s ease-out;
}

.bottom-sheet {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  padding: 16rpx 24rpx 0;
  border-radius: 38rpx 38rpx 0 0;
  background: #f7f8fb;
  box-shadow: 0 -16rpx 50rpx rgba(17, 27, 47, 0.18);
  animation: sheetIn 0.25s ease-out;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 4rpx;
  background: #d2d7e1;
}

.sheet-preview-row {
  display: flex;
  align-items: center;
  padding: 10rpx 4rpx 24rpx;
}

.sheet-preview {
  width: 92rpx;
  height: 92rpx;
  overflow: hidden;
  flex: none;
  border-radius: 24rpx;
  background: #e7ebf2;
}

.sheet-media {
  width: 100%;
  height: 100%;
}

.sheet-video-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding-left: 4rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #ef9a55, #f5c06d);
  font-size: 30rpx;
}

.sheet-copy {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.sheet-title {
  color: #20293e;
  font-size: 29rpx;
  font-weight: 700;
}

.sheet-desc {
  margin-top: 6rpx;
  color: #8d96a7;
  font-size: 22rpx;
}

.sheet-action {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 112rpx;
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 25rpx;
  text-align: left;
  background: #ffffff;
}

.sheet-action-primary {
  color: #286be6;
}

.sheet-action-danger {
  color: #df4b52;
}

.sheet-action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  flex: none;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.action-use {
  color: #2d70e9;
  background: #eaf1ff;
}

.action-delete {
  color: #df4b52;
  background: #fff0f0;
  font-size: 40rpx;
  font-weight: 350;
}

.sheet-action-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 18rpx;
}

.sheet-action-title {
  color: #293248;
  font-size: 26rpx;
  font-weight: 650;
}

.sheet-action-desc {
  margin-top: 5rpx;
  color: #929bad;
  font-size: 20rpx;
}

.sheet-action-arrow {
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.sheet-cancel {
  width: 100%;
  height: 88rpx;
  margin-top: 2rpx;
  border-radius: 25rpx;
  color: #687287;
  background: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.sheet-action-pressed {
  opacity: 0.76;
  transform: scale(0.99);
}

@keyframes historyRotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes maskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes sheetIn {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
